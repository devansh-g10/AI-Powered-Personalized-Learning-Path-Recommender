# Server Port
PORT=4000

# Supabase Auth & Project Details
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Prisma & Database Connections (PostgreSQL)
# Direct connection for migrations:
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.your-project.supabase.co:5432/postgres
# Connection pooled URL for runtime (PgBouncer):
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Frontend URL (For CORS and Google OAuth Redirects)
CLIENT_URL=https://your-frontend.vercel.app
GOOGLE_REDIRECT_URL=https://your-frontend.vercel.app/auth/callback

# Mistral AI API Key (from https://console.mistral.ai)
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_MODEL=mistral-small-latest

# Redis (Upstash, Render Redis, or Redis Cloud)
# Format: rediss://default:password@your-host:6379 or redis://localhost:6379
REDIS_URL=redis://localhost:6379
